rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Default Deny All Catch-all: Closes unrestricted access across the bucket
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // --- Authentication & Identity Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // DIRECTKPMBP Authorized Master Administrators
    function isDirectKpmbpAdmin() {
      return isEmailVerified() && (
        request.auth.token.email == 'cgkhairi2u@gmail.com' ||
        request.auth.token.email == 'chegukay@gmail.com' ||
        request.auth.token.email == 'cikgukyee@gmail.com' ||
        request.auth.token.email == 'kpmbp2u@gmail.com' ||
        request.auth.token.email == 'khaikerr@gmail.com' ||
        request.auth.token.email == 'festivalseni.kpmbp@gmail.com' ||
        request.auth.token.email == 'kpmbppsn@gmail.com'
      );
    }

    // Enforce max 5MB file size and explicit safe image MIME types for create/update
    function isValidImage() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in [
          'image/png',
          'image/jpeg',
          'image/webp',
          'image/svg+xml',
          'image/x-icon',
          'image/vnd.microsoft.icon',
          'image/gif'
        ];
    }

    // --- Platform Module Assets (Logo & Thumbnail uploads) ---
    match /platforms/directkpmbp/platform_assets/{assetFile} {
      allow read: if true;
      allow create, update: if isDirectKpmbpAdmin() && isValidImage();
      allow delete: if isDirectKpmbpAdmin();
    }

    // --- PDF Document Thumbnails ---
    match /platforms/directkpmbp/thumbnails/{thumbFile} {
      allow read: if true;
      allow create, update: if isDirectKpmbpAdmin() && isValidImage();
      allow delete: if isDirectKpmbpAdmin();
    }

    // --- Portal Assets (if uploaded by Admin) ---
    match /platforms/directkpmbp/portal_assets/{assetFile} {
      allow read: if true;
      allow create, update: if isDirectKpmbpAdmin() && isValidImage();
      allow delete: if isDirectKpmbpAdmin();
    }
  }
}
