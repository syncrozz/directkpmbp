{
  "entities": {
    "staff": {
      "title": "Staff",
      "description": "Senarai Rekod Staf / Kakitangan KPMBP",
      "type": "object",
      "properties": {
        "ID": { "type": "string" },
        "Nama": { "type": "string" },
        "Jawatan": { "type": "string" },
        "Bahagian": { "type": "string" },
        "DepartmentID": { "type": "string" },
        "Gred": { "type": "string" },
        "Email": { "type": "string" },
        "NoTel": { "type": "string" },
        "NoBilik": { "type": "string" },
        "Gambar": { "type": "string" },
        "Pendidikan": { "type": "string" },
        "Anugerah": { "type": "string" },
        "Penyelidikan": { "type": "string" },
        "BidangKepakaran": { "type": "string" },
        "Catatan": { "type": "string" },
        "Status": { "type": "string" }
      },
      "required": ["ID", "Nama"]
    },
    "committees": {
      "title": "StaffCommittee",
      "description": "Rekod Jawatankuasa Kakitangan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "staff_id": { "type": "string" },
        "staff_nama": { "type": "string" },
        "jawatankuasa": { "type": "string" },
        "peranan": { "type": "string" },
        "peringkat": { "type": "string" },
        "tahun": { "type": "string" },
        "catatan": { "type": "string" }
      },
      "required": ["id", "staff_id"]
    },
    "systemData": {
      "title": "SystemData",
      "description": "Dokumen ringkasan dan data pukal sistem",
      "type": "object",
      "properties": {
        "updatedAt": { "type": "string" },
        "count": { "type": "number" },
        "data": { "type": "array" }
      }
    },
    "admin": {
      "title": "AuthorizedAdmin",
      "description": "Rekod kebenaran pentadbir portal KPMBP",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "level": { "type": "number" },
        "status": { "type": "string" },
        "verifiedAt": { "type": "string" }
      },
      "required": ["email", "role", "level"]
    },
    "portalLink": {
      "title": "PortalLink",
      "description": "Rekod pautan rasmi Portal Kolej KPMBP",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "desc": { "type": "string" },
        "url": { "type": "string" },
        "audience": { "type": "string", "enum": ["Pelajar", "Staf", "Kedua-dua"] },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "faviconUrl": { "type": "string" },
        "sortOrder": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "title", "url", "audience"]
    },
    "platformLink": {
      "title": "PlatformLink",
      "description": "Rekod pautan platform luar khas di bawah tab Platform Rujukan Kolej",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-\\.]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "url": { "type": "string", "minLength": 8, "maxLength": 2000, "pattern": "^https?://.+" },
        "description": { "type": "string", "maxLength": 1000 },
        "logoUrl": { "type": "string", "maxLength": 2000 },
        "thumbnailUrl": { "type": "string", "maxLength": 2000 },
        "thumbnailSource": {
          "type": "string",
          "enum": ["homepage_snapshot", "og_image", "favicon", "custom_upload", "placeholder"]
        },
        "thumbnailGeneratedAt": { "type": "string", "maxLength": 64 },
        "detectedMeta": { "type": "object" },
        "sortOrder": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "updatedBy": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "name", "url", "sortOrder", "isActive"]
    },
    "deadline": {
      "title": "DeadlineRecord",
      "description": "Rekod tarikh akhir rasmi Syncrozz Deadline Hub KPMBP",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-\\.]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "titleEmphasis": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string", "maxLength": 2000 },
        "requiredAction": { "type": "string", "maxLength": 500 },
        "category": {
          "type": "string",
          "enum": ["Akademik", "HEA", "HEP", "Pengurusan", "Pentadbiran", "Penilaian", "Pencalonan", "Dokumentasi", "Other"]
        },
        "targetAudience": { "type": "array", "items": { "type": "string" } },
        "targetDepartments": { "type": "array", "items": { "type": "string" } },
        "targetStaffIds": { "type": "array", "items": { "type": "string" } },
        "dueDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "dueTime": { "type": "string" },
        "timezone": { "type": "string", "enum": ["Asia/Kuala_Lumpur"] },
        "actionUrl": { "type": "string", "maxLength": 2000 },
        "actionLabel": { "type": "string", "maxLength": 120 },
        "attachments": { "type": "array" },
        "instructions": { "type": "string", "maxLength": 4000 },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE", "ARCHIVED"] },
        "isPublished": { "type": "boolean" },
        "sourceType": { "type": "string", "enum": ["SCREENSHOT", "PDF", "PASTED_TEXT"] },
        "sourceSummary": { "type": "string", "maxLength": 500 },
        "sourceEvidencePaths": { "type": "array", "items": { "type": "string" } },
        "confidenceScore": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "createdBy": { "type": "string", "maxLength": 200 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "updatedBy": { "type": "string", "maxLength": 200 },
        "publishedAt": { "type": "string", "maxLength": 64 },
        "publishedBy": { "type": "string", "maxLength": 200 },
        "archivedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "title", "category", "dueDate", "timezone", "status", "isPublished", "sourceType", "createdAt", "createdBy", "updatedAt", "updatedBy"]
    },
    "deadlineDraft": {
      "title": "DeadlineDraft",
      "description": "Draf ekstrak AI tarikh akhir yang menunggu semakan & pengesahan Master Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-\\.]+$" },
        "submissionBatchId": { "type": "string", "maxLength": 128 },
        "sourceType": { "type": "string", "enum": ["SCREENSHOT", "PDF", "PASTED_TEXT"] },
        "sourceEvidence": { "type": "object" },
        "title": { "type": "string", "maxLength": 200 },
        "titleEmphasis": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string", "maxLength": 2000 },
        "requiredAction": { "type": "string", "maxLength": 500 },
        "category": {
          "type": "string",
          "enum": ["Akademik", "HEA", "HEP", "Pengurusan", "Pentadbiran", "Penilaian", "Pencalonan", "Dokumentasi", "Other"]
        },
        "targetAudience": { "type": "array", "items": { "type": "string" } },
        "targetDepartments": { "type": "array", "items": { "type": "string" } },
        "targetStaffIds": { "type": "array", "items": { "type": "string" } },
        "dueDate": { "type": "string", "maxLength": 32 },
        "dueTime": { "type": "string", "maxLength": 16 },
        "timezone": { "type": "string", "enum": ["Asia/Kuala_Lumpur"] },
        "announcementDate": { "type": "string", "maxLength": 32 },
        "actionUrl": { "type": "string", "maxLength": 2000 },
        "actionLabel": { "type": "string", "maxLength": 120 },
        "attachments": { "type": "array" },
        "instructions": { "type": "string", "maxLength": 4000 },
        "sourceExcerpt": { "type": "string", "maxLength": 2000 },
        "confidence": { "type": "object" },
        "missingFields": { "type": "array", "items": { "type": "string" } },
        "ambiguousFields": { "type": "array", "items": { "type": "string" } },
        "ambiguityReason": { "type": "string", "maxLength": 1000 },
        "requiresReview": { "type": "boolean" },
        "duplicateMatch": { "type": ["object", "null"] },
        "reviewStatus": { "type": "string", "enum": ["pending", "approved", "rejected", "published", "ignored"] },
        "resolutionAction": { "type": "string", "enum": ["create", "update_existing", "ignore"] },
        "targetExistingDeadlineId": { "type": "string", "maxLength": 128 },
        "updateReason": { "type": "string", "maxLength": 500 },
        "reviewedBy": { "type": "string", "maxLength": 200 },
        "reviewedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "createdBy": { "type": "string", "maxLength": 200 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "submissionBatchId", "sourceType", "title", "category", "timezone", "reviewStatus", "resolutionAction", "createdAt", "createdBy", "updatedAt"]
    },
    "deadlineAuditLog": {
      "title": "DeadlineAuditLog",
      "description": "Rekod audit perubahan dan penerbitan tarikh akhir",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-\\.]+$" },
        "deadlineId": { "type": "string", "maxLength": 128 },
        "deadlineTitle": { "type": "string", "maxLength": 200 },
        "draftId": { "type": "string", "maxLength": 128 },
        "action": {
          "type": "string",
          "enum": ["CREATED", "PUBLISHED", "UPDATED_FROM_AI", "UPDATED_MANUAL", "ARCHIVED", "RESTORED", "STATUS_CHANGED", "IGNORED_DRAFT", "DELETED"]
        },
        "previousValues": { "type": "object" },
        "updatedValues": { "type": "object" },
        "reason": { "type": "string", "maxLength": 1000 },
        "sourceType": { "type": "string", "enum": ["SCREENSHOT", "PDF", "PASTED_TEXT"] },
        "sourceRef": { "type": "string", "maxLength": 500 },
        "performedBy": { "type": "string", "maxLength": 200 },
        "performedByUid": { "type": "string", "maxLength": 128 },
        "performedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "deadlineId", "deadlineTitle", "action", "performedBy", "performedAt"]
    }
  },
  "firestore": {
    "/staff/{staffId}": {
      "schema": "staff",
      "description": "Koleksi profil kakitangan KPMBP"
    },
    "/committees/{committeeId}": {
      "schema": "committees",
      "description": "Koleksi rekod jawatankuasa kakitangan"
    },
    "/system/{systemDocId}": {
      "schema": "systemData",
      "description": "Storan data pukal pantas bagi staff dan jawatankuasa"
    },
    "/admins/{adminId}": {
      "schema": "admin",
      "description": "Koleksi pentadbir diotorisasi yang dikawal selia oleh Master Admin"
    },
    "/platforms/directkpmbp/config/{configId}": {
      "schema": "systemData",
      "description": "Konfigurasi terasing DIRECTKPMBP (navigation, takwim, portalMeta)"
    },
    "/platforms/directkpmbp/portalLinks/{portalId}": {
      "schema": "portalLink",
      "description": "Koleksi pautan portal dinamik KPMBP di platform SYNCROZZ"
    },
    "/platforms/directkpmbp/platformLinks/{platformId}": {
      "schema": "platformLink",
      "description": "Koleksi terasing pautan platform luar bagi tab Platform di bawah Rujukan Kolej"
    },
    "/deadlines/{deadlineId}": {
      "schema": "deadline",
      "description": "Rekod tarikh akhir rasmi yang diterbitkan ke Syncrozz Deadline Hub"
    },
    "/deadline_drafts/{draftId}": {
      "schema": "deadlineDraft",
      "description": "Draf ekstrak AI tarikh akhir untuk semakan Master Admin"
    },
    "/deadline_audit_logs/{logId}": {
      "schema": "deadlineAuditLog",
      "description": "Log audit tarikh akhir (dicipta, dikemas kini, diterbitkan, diarkibkan)"
    }
  }
}
