{
  "entities": {
    "staff": {
      "title": "Staff",
      "description": "Senarai Rekod Staf / Kakitangan KPMBP",
      "type": "object",
      "properties": {
        "ID": { "type": "string" },
        "Nama": { "type": "string" },
        "Jawatan": { "type": "string" },
        "Bahagian": { "type": "string" },
        "DepartmentID": { "type": "string" },
        "Gred": { "type": "string" },
        "Email": { "type": "string" },
        "NoTel": { "type": "string" },
        "NoBilik": { "type": "string" },
        "Gambar": { "type": "string" },
        "Pendidikan": { "type": "string" },
        "Anugerah": { "type": "string" },
        "Penyelidikan": { "type": "string" },
        "BidangKepakaran": { "type": "string" },
        "Catatan": { "type": "string" },
        "Status": { "type": "string" }
      },
      "required": ["ID", "Nama"]
    },
    "committees": {
      "title": "StaffCommittee",
      "description": "Rekod Jawatankuasa Kakitangan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "staff_id": { "type": "string" },
        "staff_nama": { "type": "string" },
        "jawatankuasa": { "type": "string" },
        "peranan": { "type": "string" },
        "peringkat": { "type": "string" },
        "tahun": { "type": "string" },
        "catatan": { "type": "string" }
      },
      "required": ["id", "staff_id"]
    },
    "systemData": {
      "title": "SystemData",
      "description": "Dokumen ringkasan dan data pukal sistem",
      "type": "object",
      "properties": {
        "updatedAt": { "type": "string" },
        "count": { "type": "number" },
        "data": { "type": "array" }
      }
    },
    "admin": {
      "title": "AuthorizedAdmin",
      "description": "Rekod kebenaran pentadbir portal KPMBP",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "level": { "type": "number" },
        "status": { "type": "string" },
        "verifiedAt": { "type": "string" }
      },
      "required": ["email", "role", "level"]
    }
  },
  "firestore": {
    "/staff/{staffId}": {
      "schema": "staff",
      "description": "Koleksi profil kakitangan KPMBP"
    },
    "/committees/{committeeId}": {
      "schema": "committees",
      "description": "Koleksi rekod jawatankuasa kakitangan"
    },
    "/system/{systemDocId}": {
      "schema": "systemData",
      "description": "Storan data pukal pantas bagi staff dan jawatankuasa"
    },
    "/admins/{adminId}": {
      "schema": "admin",
      "description": "Koleksi pentadbir diotorisasi yang dikawal selia oleh Master Admin"
    }
  }
}
