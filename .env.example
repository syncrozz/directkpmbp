# Comma-separated exact origins allowed by CORS (no wildcards).
# Includes production, Firebase Hosting, AI Studio preview, and local dev defaults.
ALLOWED_ORIGINS=https://directkpmbp.syncrozz.com,https://syncrozz-platform.web.app,https://syncrozz-platform.firebaseapp.com,https://ais-dev-zpx2fcfrhhjwlq6d2o6nm4-348541131117.asia-east1.run.app,https://ais-pre-zpx2fcfrhhjwlq6d2o6nm4-348541131117.asia-east1.run.app,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Optional custom Chromium binary path; leave empty to auto-detect via Playwright/system paths.
CHROMIUM_EXECUTABLE_PATH=
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# Disable Vite HMR in AI Studio/preview environments ("true" disables HMR, "false" enables locally).
DISABLE_HMR=true

# Optional Firebase Web API key overrides (empty by default; loaded from firebase-applet-config.json).
FIREBASE_API_KEY=
VITE_FIREBASE_API_KEY=

# Optional external Cloud Run snapshot API base URL; leave empty to use same-origin /api/platform/snapshot.
VITE_SNAPSHOT_API_BASE_URL=