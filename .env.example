# ==============================================================================
# DIRECTKPMBP — Zero-Friction Environment Configuration (SES v4.5)
# ==============================================================================
# AI Studio & local development work out-of-the-box with NO manual env prompts:
# - Firebase config is loaded from firebase-applet-config.json
# - Headless Chromium is auto-discovered via Playwright & system fallback paths
# - Snapshot API defaults to same-origin /api/platform/snapshot in development
#
# OPTIONAL (Runtime defaults apply automatically if unset):
# PORT=3000
# NODE_ENV=development
# DISABLE_HMR=true
#
# DEPLOYMENT-ONLY (Required only for split Vercel + Cloud Run production):
# VITE_SNAPSHOT_API_BASE_URL=https://<your-cloud-run-snapshot-service>.run.app
# ALLOWED_ORIGINS=https://directkpmbp.syncrozz.com,https://syncrozz-platform.web.app