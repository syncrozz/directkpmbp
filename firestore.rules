rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All Catch-all: Closes unrestricted access across all collections
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Authentication & Identity Verification Primitives ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Official Master Administrator: Strictly verified via Google Auth
    function isMasterAdmin() {
      return isEmailVerified() && (
        request.auth.token.email == 'cgkhairi2u@gmail.com' ||
        request.auth.token.email == 'chegukay@gmail.com' ||
        request.auth.token.email == 'cikgukyee@gmail.com' ||
        request.auth.token.email == 'kpmbp2u@gmail.com' ||
        request.auth.token.email == 'khaikerr@gmail.com' ||
        request.auth.token.email == 'festivalseni.kpmbp@gmail.com' ||
        request.auth.token.email == 'kpmbppsn@gmail.com'
      );
    }

    function isAuthorizedAdmin() {
      return isMasterAdmin();
    }

    function isValidId(id) {
      return id is string
        && id.size() > 0
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function isValidHttpUrl(val) {
      return val is string
        && val.size() >= 8
        && val.size() <= 2000
        && val.matches('^https?://.+');
    }

    function isValidOptionalHttpUrl(val) {
      return val is string
        && val.size() <= 2000
        && (val == '' || val.matches('^https?://.+'));
    }

    function isValidStringList(val, maxItems, maxLen) {
      return val is list
        && val.size() <= maxItems
        && (val.size() == 0 || (val[0] is string && val[0].size() <= maxLen));
    }

    // --- PlatformLink Blueprint Validation ---
    function isValidPlatformDetectedMeta(meta) {
      return meta is map
        && meta.keys().hasOnly([
          'title',
          'description',
          'ogTitle',
          'ogDescription',
          'ogImage',
          'ogUrl',
          'ogSiteName',
          'favicon',
          'pwaIcon',
          'manifestName'
        ])
        && (!('title' in meta) || (meta.title is string && meta.title.size() <= 300))
        && (!('description' in meta) || (meta.description is string && meta.description.size() <= 1000))
        && (!('ogTitle' in meta) || (meta.ogTitle is string && meta.ogTitle.size() <= 300))
        && (!('ogDescription' in meta) || (meta.ogDescription is string && meta.ogDescription.size() <= 1000))
        && (!('ogImage' in meta) || (meta.ogImage is string && meta.ogImage.size() <= 2000))
        && (!('ogUrl' in meta) || (meta.ogUrl is string && meta.ogUrl.size() <= 2000))
        && (!('ogSiteName' in meta) || (meta.ogSiteName is string && meta.ogSiteName.size() <= 200))
        && (!('favicon' in meta) || (meta.favicon is string && meta.favicon.size() <= 2000))
        && (!('pwaIcon' in meta) || (meta.pwaIcon is string && meta.pwaIcon.size() <= 2000))
        && (!('manifestName' in meta) || (meta.manifestName is string && meta.manifestName.size() <= 200));
    }

    function isValidPlatformLink(data, platformId) {
      return data.keys().hasAll(['id', 'name', 'url', 'sortOrder', 'isActive'])
        && data.keys().hasOnly([
          'id',
          'name',
          'url',
          'description',
          'logoUrl',
          'thumbnailUrl',
          'thumbnailSource',
          'thumbnailGeneratedAt',
          'detectedMeta',
          'sortOrder',
          'isActive',
          'createdAt',
          'updatedAt',
          'updatedBy'
        ])
        && data.id is string
        && data.id == platformId
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 200
        && isValidHttpUrl(data.url)
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && (!('logoUrl' in data) || isValidOptionalHttpUrl(data.logoUrl))
        && (!('thumbnailUrl' in data) || isValidOptionalHttpUrl(data.thumbnailUrl))
        && (!('thumbnailSource' in data) || (data.thumbnailSource is string && data.thumbnailSource in ['homepage_snapshot', 'og_image', 'favicon', 'custom_upload', 'placeholder']))
        && (!('thumbnailGeneratedAt' in data) || (data.thumbnailGeneratedAt is string && data.thumbnailGeneratedAt.size() <= 64))
        && (!('detectedMeta' in data) || isValidPlatformDetectedMeta(data.detectedMeta))
        && data.sortOrder is number
        && data.sortOrder >= 0
        && data.sortOrder <= 9999
        && data.isActive is bool
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64))
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 200));
    }

    // --- Syncrozz Deadline Hub Blueprint Validation ---
    function isValidDeadlineCategory(cat) {
      return cat is string
        && cat in ['Akademik', 'HEA', 'HEP', 'Pengurusan', 'Pentadbiran', 'Penilaian', 'Pencalonan', 'Dokumentasi', 'Other'];
    }

    function isValidDeadlineSourceType(st) {
      return st is string && st in ['SCREENSHOT', 'PDF', 'PASTED_TEXT'];
    }

    function isValidDeadline(data, deadlineId) {
      return data.keys().hasAll([
          'id', 'title', 'category', 'dueDate', 'timezone',
          'status', 'isPublished', 'sourceType',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'description', 'requiredAction', 'category',
          'targetAudience', 'targetDepartments', 'targetStaffIds',
          'dueDate', 'dueTime', 'timezone', 'actionUrl', 'actionLabel',
          'attachments', 'instructions', 'status', 'isPublished',
          'sourceType', 'sourceSummary', 'sourceEvidencePaths', 'confidenceScore',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
          'publishedAt', 'publishedBy', 'archivedAt'
        ])
        && data.id is string
        && data.id == deadlineId
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 200
        && (!('description' in data) || (data.description is string && data.description.size() <= 2000))
        && (!('requiredAction' in data) || (data.requiredAction is string && data.requiredAction.size() <= 500))
        && isValidDeadlineCategory(data.category)
        && (!('targetAudience' in data) || isValidStringList(data.targetAudience, 30, 120))
        && (!('targetDepartments' in data) || isValidStringList(data.targetDepartments, 30, 120))
        && (!('targetStaffIds' in data) || isValidStringList(data.targetStaffIds, 100, 64))
        && data.dueDate is string
        && data.dueDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (!('dueTime' in data) || (data.dueTime is string && (data.dueTime == '' || data.dueTime.matches('^([01]\\d|2[0-3]):[0-5]\\d$'))))
        && data.timezone == 'Asia/Kuala_Lumpur'
        && (!('actionUrl' in data) || isValidOptionalHttpUrl(data.actionUrl))
        && (!('actionLabel' in data) || (data.actionLabel is string && data.actionLabel.size() <= 120))
        && (!('attachments' in data) || (data.attachments is list && data.attachments.size() <= 20))
        && (!('instructions' in data) || (data.instructions is string && data.instructions.size() <= 4000))
        && data.status is string
        && data.status in ['ACTIVE', 'INACTIVE', 'ARCHIVED']
        && data.isPublished is bool
        && isValidDeadlineSourceType(data.sourceType)
        && (!('sourceSummary' in data) || (data.sourceSummary is string && data.sourceSummary.size() <= 500))
        && (!('sourceEvidencePaths' in data) || isValidStringList(data.sourceEvidencePaths, 20, 500))
        && (!('confidenceScore' in data) || (data.confidenceScore is number && data.confidenceScore >= 0 && data.confidenceScore <= 1))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.createdBy is string && data.createdBy.size() <= 200
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.updatedBy is string && data.updatedBy.size() <= 200
        && (!('publishedAt' in data) || (data.publishedAt is string && data.publishedAt.size() <= 64))
        && (!('publishedBy' in data) || (data.publishedBy is string && data.publishedBy.size() <= 200))
        && (!('archivedAt' in data) || (data.archivedAt is string && data.archivedAt.size() <= 64));
    }

    function isValidDeadlineDraft(data, draftId) {
      return data.keys().hasAll([
          'id', 'submissionBatchId', 'sourceType', 'title', 'category',
          'timezone', 'reviewStatus', 'resolutionAction',
          'createdAt', 'createdBy', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'submissionBatchId', 'sourceType', 'sourceEvidence',
          'title', 'description', 'requiredAction', 'category',
          'targetAudience', 'targetDepartments', 'targetStaffIds',
          'dueDate', 'dueTime', 'timezone', 'announcementDate',
          'actionUrl', 'actionLabel', 'attachments', 'instructions',
          'sourceExcerpt', 'confidence', 'missingFields', 'ambiguousFields',
          'ambiguityReason', 'requiresReview', 'duplicateMatch',
          'reviewStatus', 'resolutionAction', 'targetExistingDeadlineId',
          'updateReason', 'reviewedBy', 'reviewedAt',
          'createdAt', 'createdBy', 'updatedAt'
        ])
        && data.id is string
        && data.id == draftId
        && data.submissionBatchId is string && data.submissionBatchId.size() <= 128
        && isValidDeadlineSourceType(data.sourceType)
        && (!('sourceEvidence' in data) || data.sourceEvidence is map)
        && data.title is string && data.title.size() <= 200
        && (!('description' in data) || (data.description is string && data.description.size() <= 2000))
        && (!('requiredAction' in data) || (data.requiredAction is string && data.requiredAction.size() <= 500))
        && isValidDeadlineCategory(data.category)
        && (!('targetAudience' in data) || isValidStringList(data.targetAudience, 30, 120))
        && (!('targetDepartments' in data) || isValidStringList(data.targetDepartments, 30, 120))
        && (!('targetStaffIds' in data) || isValidStringList(data.targetStaffIds, 100, 64))
        && (!('dueDate' in data) || (data.dueDate is string && (data.dueDate == '' || data.dueDate.matches('^\\d{4}-\\d{2}-\\d{2}$'))))
        && (!('dueTime' in data) || (data.dueTime is string && (data.dueTime == '' || data.dueTime.matches('^([01]\\d|2[0-3]):[0-5]\\d$'))))
        && data.timezone == 'Asia/Kuala_Lumpur'
        && (!('announcementDate' in data) || (data.announcementDate is string && data.announcementDate.size() <= 32))
        && (!('actionUrl' in data) || isValidOptionalHttpUrl(data.actionUrl))
        && (!('actionLabel' in data) || (data.actionLabel is string && data.actionLabel.size() <= 120))
        && (!('attachments' in data) || (data.attachments is list && data.attachments.size() <= 20))
        && (!('instructions' in data) || (data.instructions is string && data.instructions.size() <= 4000))
        && (!('sourceExcerpt' in data) || (data.sourceExcerpt is string && data.sourceExcerpt.size() <= 2000))
        && (!('confidence' in data) || data.confidence is map)
        && (!('missingFields' in data) || isValidStringList(data.missingFields, 20, 64))
        && (!('ambiguousFields' in data) || isValidStringList(data.ambiguousFields, 20, 64))
        && (!('ambiguityReason' in data) || (data.ambiguityReason is string && data.ambiguityReason.size() <= 1000))
        && (!('requiresReview' in data) || data.requiresReview is bool)
        && (!('duplicateMatch' in data) || data.duplicateMatch == null || data.duplicateMatch is map)
        && data.reviewStatus in ['pending', 'approved', 'rejected', 'published', 'ignored']
        && data.resolutionAction in ['create', 'update_existing', 'ignore']
        && (!('targetExistingDeadlineId' in data) || (data.targetExistingDeadlineId is string && data.targetExistingDeadlineId.size() <= 128))
        && (!('updateReason' in data) || (data.updateReason is string && data.updateReason.size() <= 500))
        && (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 200))
        && (!('reviewedAt' in data) || (data.reviewedAt is string && data.reviewedAt.size() <= 64))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.createdBy is string && data.createdBy.size() <= 200
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidDeadlineAuditLog(data, logId) {
      return data.keys().hasAll([
          'id', 'deadlineId', 'deadlineTitle', 'action', 'performedBy', 'performedAt'
        ])
        && data.keys().hasOnly([
          'id', 'deadlineId', 'deadlineTitle', 'draftId', 'action',
          'previousValues', 'updatedValues', 'reason', 'sourceType',
          'sourceRef', 'performedBy', 'performedByUid', 'performedAt'
        ])
        && data.id is string
        && data.id == logId
        && data.deadlineId is string && data.deadlineId.size() >= 1 && data.deadlineId.size() <= 128
        && data.deadlineTitle is string && data.deadlineTitle.size() >= 1 && data.deadlineTitle.size() <= 200
        && (!('draftId' in data) || (data.draftId is string && data.draftId.size() <= 128))
        && data.action in [
          'CREATED', 'PUBLISHED', 'UPDATED_FROM_AI', 'UPDATED_MANUAL',
          'ARCHIVED', 'RESTORED', 'STATUS_CHANGED', 'IGNORED_DRAFT', 'DELETED'
        ]
        && (!('previousValues' in data) || data.previousValues is map)
        && (!('updatedValues' in data) || data.updatedValues is map)
        && (!('reason' in data) || (data.reason is string && data.reason.size() <= 1000))
        && (!('sourceType' in data) || isValidDeadlineSourceType(data.sourceType))
        && (!('sourceRef' in data) || (data.sourceRef is string && data.sourceRef.size() <= 500))
        && data.performedBy is string && data.performedBy.size() >= 1 && data.performedBy.size() <= 200
        && (!('performedByUid' in data) || (data.performedByUid is string && data.performedByUid.size() <= 128))
        && data.performedAt is string && data.performedAt.size() <= 64;
    }

    // --- Staff Collection ---
    match /staff/{staffId} {
      allow get, list: if true;
      allow create, update: if isAuthorizedAdmin() && isValidId(staffId);
      allow delete: if isAuthorizedAdmin() && isValidId(staffId);
    }

    // --- Committees Collection ---
    match /committees/{committeeId} {
      allow get, list: if true;
      allow create, update: if isAuthorizedAdmin() && isValidId(committeeId);
      allow delete: if isAuthorizedAdmin() && isValidId(committeeId);
    }

    // --- System Batch Cache Documents (staff_data, committee_data only) ---
    match /system/{docId} {
      allow get, list: if docId in ['staff_data', 'committee_data'];
      allow create, update: if isAuthorizedAdmin()
        && isValidId(docId)
        && docId in ['staff_data', 'committee_data'];
      allow delete: if isAuthorizedAdmin()
        && isValidId(docId)
        && docId in ['staff_data', 'committee_data'];
    }

    // --- Admins Collection ---
    match /admins/{adminId} {
      allow get, list: if isMasterAdmin();
      allow create, update: if isMasterAdmin() && isValidId(adminId);
      allow delete: if isMasterAdmin() && isValidId(adminId);
    }

    // --- Portal Kolej Collection (Strictly isolated from Platform) ---
    match /platforms/directkpmbp/portalLinks/{portalId} {
      allow get, list: if true;
      allow create, update: if isAuthorizedAdmin() && isValidId(portalId);
      allow delete: if isAuthorizedAdmin() && isValidId(portalId);
    }

    // --- Platform Links Collection (Tab Platform - Rujukan Kolej) ---
    match /platforms/directkpmbp/platformLinks/{platformId} {
      allow get, list: if true;
      allow create: if isAuthorizedAdmin()
        && isValidId(platformId)
        && isValidPlatformLink(request.resource.data, platformId);
      allow update: if isAuthorizedAdmin()
        && isValidId(platformId)
        && isValidPlatformLink(request.resource.data, platformId)
        && request.resource.data.id == resource.data.id
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'url',
          'description',
          'logoUrl',
          'thumbnailUrl',
          'thumbnailSource',
          'thumbnailGeneratedAt',
          'detectedMeta',
          'sortOrder',
          'isActive',
          'updatedAt',
          'updatedBy'
        ]);
      allow delete: if isAuthorizedAdmin() && isValidId(platformId);
    }

    // --- Explicit Platform Configuration Documents (navigation, takwim, portalMeta only) ---
    match /platforms/directkpmbp/config/{configId} {
      allow get, list: if configId in ['navigation', 'takwim', 'portalMeta'];
      allow create, update: if isAuthorizedAdmin()
        && isValidId(configId)
        && configId in ['navigation', 'takwim', 'portalMeta'];
      allow delete: if isAuthorizedAdmin()
        && isValidId(configId)
        && configId in ['navigation', 'takwim', 'portalMeta'];
    }

    // --- Syncrozz Deadline Hub: Published Deadlines ---
    // Query-enforced: Ordinary staff only read/list published non-inactive deadlines; Admins have full management access
    match /deadlines/{deadlineId} {
      allow get, list: if isAuthorizedAdmin()
        || (resource.data.isPublished == true && resource.data.status in ['ACTIVE', 'ARCHIVED']);
      allow create: if isAuthorizedAdmin()
        && isValidId(deadlineId)
        && isValidDeadline(request.resource.data, deadlineId)
        && request.resource.data.createdBy == request.auth.token.email;
      allow update: if isAuthorizedAdmin()
        && isValidId(deadlineId)
        && isValidDeadline(request.resource.data, deadlineId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'requiredAction', 'category',
          'targetAudience', 'targetDepartments', 'targetStaffIds',
          'dueDate', 'dueTime', 'timezone', 'actionUrl', 'actionLabel',
          'attachments', 'instructions', 'status', 'isPublished',
          'sourceType', 'sourceSummary', 'sourceEvidencePaths', 'confidenceScore',
          'updatedAt', 'updatedBy', 'publishedAt', 'publishedBy', 'archivedAt'
        ]);
      allow delete: if isAuthorizedAdmin() && isValidId(deadlineId);
    }

    // --- Syncrozz Deadline Hub: AI Extraction Drafts (Strictly Master Admin Only) ---
    match /deadline_drafts/{draftId} {
      allow get, list: if isAuthorizedAdmin();
      allow create: if isAuthorizedAdmin()
        && isValidId(draftId)
        && isValidDeadlineDraft(request.resource.data, draftId)
        && request.resource.data.createdBy == request.auth.token.email;
      allow update: if isAuthorizedAdmin()
        && isValidId(draftId)
        && isValidDeadlineDraft(request.resource.data, draftId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'requiredAction', 'category',
          'targetAudience', 'targetDepartments', 'targetStaffIds',
          'dueDate', 'dueTime', 'timezone', 'announcementDate',
          'actionUrl', 'actionLabel', 'attachments', 'instructions',
          'sourceExcerpt', 'confidence', 'missingFields', 'ambiguousFields',
          'ambiguityReason', 'requiresReview', 'duplicateMatch',
          'reviewStatus', 'resolutionAction', 'targetExistingDeadlineId',
          'updateReason', 'reviewedBy', 'reviewedAt', 'updatedAt'
        ]);
      allow delete: if isAuthorizedAdmin() && isValidId(draftId);
    }

    // --- Syncrozz Deadline Hub: Immutable Audit Logs (Strictly Master Admin Only) ---
    match /deadline_audit_logs/{logId} {
      allow get, list: if isAuthorizedAdmin();
      allow create: if isAuthorizedAdmin()
        && isValidId(logId)
        && isValidDeadlineAuditLog(request.resource.data, logId)
        && request.resource.data.performedBy == request.auth.token.email;
      allow update, delete: if false;
    }
  }
}
