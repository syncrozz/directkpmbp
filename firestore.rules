rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All Catch-all: Closes unrestricted access
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Authentication & Identity Verification Primitives ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Official Master Administrator: Strictly verified via Google Auth (kpmbp2u@gmail.com or khaikerr@gmail.com)
    function isMasterAdmin() {
      return isEmailVerified() && (
        request.auth.token.email == 'kpmbp2u@gmail.com' ||
        request.auth.token.email == 'khaikerr@gmail.com'
      );
    }

    function isAuthorizedAdmin() {
      return isMasterAdmin();
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // --- Staff Collection ---
    // Public directory read allowed for general staff card & directory display
    // Write strictly restricted to verified Master Admin (khaikerr@gmail.com)
    match /staff/{staffId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin() && isValidId(staffId);
    }

    // --- Committees Collection ---
    // Public read allowed for official committee display
    // Write strictly restricted to verified Master Admin (khaikerr@gmail.com)
    match /committees/{committeeId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin() && isValidId(committeeId);
    }

    // --- System Cache Documents (staff_data, committee_data) ---
    // Public read allowed for fast batch directory sync
    // Write strictly restricted to verified Master Admin (khaikerr@gmail.com)
    match /system/{docId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin() && isValidId(docId);
    }

    // --- Admins Collection ---
    // Protected: Strictly restricted to verified Master Admin (khaikerr@gmail.com)
    match /admins/{adminId} {
      allow read, write: if isMasterAdmin() && isValidId(adminId);
    }
  }
}
