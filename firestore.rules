rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All Catch-all: Closes unrestricted access
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Authentication & Identity Verification Primitives ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Official Master Administrator: Strictly verified via Google Auth (V2 specific mapping)
    function isMasterAdmin() {
      return isEmailVerified() && (
        request.auth.token.email == 'cgkhairi2u@gmail.com' ||
        request.auth.token.email == 'chegukay@gmail.com' ||
        request.auth.token.email == 'cikgukyee@gmail.com' ||
        request.auth.token.email == 'kpmbp2u@gmail.com' ||
        request.auth.token.email == 'khaikerr@gmail.com' ||
        request.auth.token.email == 'festivalseni.kpmbp@gmail.com' ||
        request.auth.token.email == 'kpmbppsn@gmail.com'
      );
    }

    function isAuthorizedAdmin() {
      return isMasterAdmin();
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // --- Staff Collection ---
    // Public directory read allowed for general staff card & directory display
    // Write strictly restricted to verified V2 Master Admin
    match /staff/{staffId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin() && isValidId(staffId);
    }

    // --- Committees Collection ---
    // Public read allowed for official committee display
    // Write strictly restricted to verified V2 Master Admin
    match /committees/{committeeId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin() && isValidId(committeeId);
    }

    // --- System Cache Documents (staff_data, committee_data) ---
    // Public read allowed for fast batch directory sync
    // Write strictly restricted to verified V2 Master Admin
    match /system/{docId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin() && isValidId(docId);
    }

    // --- Admins Collection ---
    // Protected: Strictly restricted to verified V2 Master Admin
    match /admins/{adminId} {
      allow get, list: if isMasterAdmin();
      allow write: if isMasterAdmin() && isValidId(adminId);
    }

    // --- Platform Isolated Namespace (SYNCROZZ Shared Platform - Portal Kolej) ---
    match /platforms/directkpmbp/portalLinks/{portalId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin() && isValidId(portalId);
    }

    // --- Platform Isolated Namespace Catch-all ---
    match /platforms/directkpmbp/{document=**} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }
  }
}
