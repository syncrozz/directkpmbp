rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All Catch-all: Closes unrestricted access
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Authentication & Identity Verification Primitives ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Official Master Administrator: Strictly verified via Google Auth
    function isMasterAdmin() {
      return isEmailVerified() && (
        request.auth.token.email == 'khaikerr@gmail.com' ||
        request.auth.token.email == 'anakcgkhairi@gmail.com' ||
        request.auth.token.email == 'cikgukyee@gmail.com'
      );
    }

    // Check if user is registered in the trusted admins collection
    function isDbAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/admins/$(request.auth.token.email)))
      );
    }

    function isAuthorizedAdmin() {
      return isMasterAdmin() || isDbAdmin();
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // --- Staff Collection ---
    // Public directory read allowed for general staff card & directory display
    // Write (create, update, delete) strictly restricted to verified authorized admins
    match /staff/{staffId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin() && isValidId(staffId);
    }

    // --- Committees Collection ---
    // Public read allowed for official committee display
    // Write strictly restricted to verified authorized admins
    match /committees/{committeeId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin() && isValidId(committeeId);
    }

    // --- System Cache Documents (staff_data, committee_data) ---
    // Public read allowed for fast batch directory sync
    // Write strictly restricted to verified authorized admins
    match /system/{docId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin() && isValidId(docId);
    }

    // --- Admins Collection ---
    // Protected: Only authenticated admins can read administrative records
    // Modification (create, update, revoke): Strictly restricted to verified Master Admin
    match /admins/{adminId} {
      allow read: if isAuthorizedAdmin();
      allow write: if isMasterAdmin() && isValidId(adminId);
    }
  }
}
